{
  "name": "jungle-jumper",
  "version": "1.0.0",
  "description": "Jungle-themed infinite vertical climber game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verify:characters": "node scripts/verify-miko-assets.mjs && esbuild scripts/verify-miko-transitions.ts --bundle --platform=node --format=esm --outfile=node_modules/character-transition-check.mjs && node node_modules/character-transition-check.mjs",
    "verify:transitions": "node scripts/verify-scene-transitions.mjs",
    "verify:feedback": "node scripts/verify-feedback.mjs",
    "verify:miko": "npm run verify:characters",
    "verify:visual": "node scripts/visual-qa.mjs",
    "verify:release": "node scripts/release-qa.mjs",
    "verify:visual-assets": "python scripts/verify-visual-assets.py",
    "verify:renderer-parity": "python scripts/verify-renderer-parity.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
